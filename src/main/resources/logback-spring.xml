<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Contract lines: RequestLogFilter already renders the JSON, so print the message as-is. -->
    <appender name="SECURITY_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- Everything else: one structured JSON object per line, so stdout stays pure JSON. -->
    <appender name="APP_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="SECURITY" level="INFO" additivity="false">
        <appender-ref ref="SECURITY_STDOUT"/>
    </logger>

    <root level="WARN">
        <appender-ref ref="APP_STDOUT"/>
    </root>
</configuration>
